{
  "name": "fieldforms",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --filter ./packages/** --filter ./apps/** run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r run test",
    "e2e": "pnpm --filter @fieldforms/web run e2e",
    "migrate": "pnpm --filter @fieldforms/api run migrate",
    "seed": "tsx scripts/seed.ts",
    "import-legacy": "tsx scripts/import-legacy.ts",
    "dev:api": "pnpm --filter @fieldforms/api run dev",
    "dev:web": "pnpm --filter @fieldforms/web run dev",
    "dev:worker": "pnpm --filter @fieldforms/worker run dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.18.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}

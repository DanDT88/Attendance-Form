# Copy to .env and change every secret before deploying. Never commit .env.
# `docker compose up` works without a .env using development defaults.

# --- Database
POSTGRES_USER=fieldforms
POSTGRES_PASSWORD=change-me-owner-password
POSTGRES_DB=fieldforms
# Password for the restricted role the API and worker use (set by the migrate step).
APP_DB_PASSWORD=change-me-app-password

# --- Web
PUBLIC_URL=https://fieldforms.example.co.za
WEB_PORT=8080
# true behind HTTPS (required in production so the session cookie is never sent in clear text)
COOKIE_SECURE=true
TRUST_PROXY=true

# --- Photo storage: a Docker volume by default. For S3 or any S3-compatible store:
BLOB_STORE=local
# BLOB_STORE=s3
# S3_ENDPOINT=            # empty for AWS; e.g. https://s3.af-south-1.wasabisys.com otherwise
# S3_REGION=af-south-1
# S3_BUCKET=fieldforms
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_FORCE_PATH_STYLE=false

# --- Email (Mailpit in development: http://localhost:8025)
SMTP_HOST=smtp.example.co.za
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=FieldForms <attendance@example.co.za>

# --- Single sign-on for managers and admins (optional). Comma-separated: microsoft,google
OIDC_PROVIDERS=
# Microsoft 365: https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_MICROSOFT_ISSUER=
OIDC_MICROSOFT_CLIENT_ID=
OIDC_MICROSOFT_CLIENT_SECRET=
# Google Workspace: https://accounts.google.com
OIDC_GOOGLE_ISSUER=
OIDC_GOOGLE_CLIENT_ID=
OIDC_GOOGLE_CLIENT_SECRET=
# Redirect URI to register with the provider: <PUBLIC_URL>/api/auth/oidc/<id>/callback

# --- Phase 3: documents and destinations
# Gotenberg (HTML/Word → PDF) basic auth; any long random value.
GOTENBERG_USERNAME=fieldforms
GOTENBERG_PASSWORD=change-me-gotenberg-password
# Destination secrets are sealed to the worker. Generate a pair with `pnpm secrets-keygen`:
# the public key goes to the API, the private key to the worker only.
SECRETS_PUBLIC_KEY=
SECRETS_PRIVATE_KEY=
# During a key rotation: the old private key, until `pnpm rotate-secrets` has re-sealed everything.
SECRETS_PRIVATE_KEY_PREVIOUS=
# Private ranges destinations may reach, comma-separated (e.g. 10.20.0.0/16 for an on-premises
# SFTP or SQL server). Public addresses are always allowed; link-local never.
DESTINATIONS_ALLOWED_PRIVATE_CIDRS=
# Development only: let destinations reach other containers on this server's network.
DESTINATIONS_ALLOW_SAME_NETWORK=false
# Require STARTTLS for SMTP (only a local mail catcher may switch this off).
SMTP_REQUIRE_TLS=true
DELIVERY_CONCURRENCY=4
EMAIL_ATTACHMENT_LIMIT_MB=10
API_RATE_LIMIT_PER_MINUTE=120

# --- Demo data: must be false in production
SEED_DEMO_DATA=false

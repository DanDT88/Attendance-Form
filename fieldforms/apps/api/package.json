{
  "name": "@fieldforms/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "worker": "node dist/worker.js",
    "start": "node dist/server.js",
    "build": "tsup",
    "migrate": "tsx src/db/migrate-cli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "seed": "tsx src/scripts/seed.ts",
    "import-legacy": "tsx src/scripts/import-legacy.ts",
    "create-admin": "tsx src/scripts/create-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fieldforms/shared": "workspace:*",
    "@node-rs/argon2": "^2.0.2",
    "exceljs": "^4.4.0",
    "fastify": "^5.6.0",
    "fastify-plugin": "^5.1.0",
    "kysely": "^0.28.7",
    "nodemailer": "^7.0.13",
    "openid-client": "^6.8.0",
    "pg": "^8.16.0",
    "pg-boss": "^10.3.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.5",
    "tsup": "^8.5.0"
  },
  "files": [
    "dist",
    "migrations"
  ]
}
